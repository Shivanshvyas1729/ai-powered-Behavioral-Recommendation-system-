# ==============================================================================
# NeuroCart SmartReco - Environment Variables Example
# Copy this file to '.env' and populate your specific configuration.
# ==============================================================================

# Mesh API Configuration (Mandatory - starts with rsk_)
MESH_API_KEY=rsk_your_mesh_api_key_here
MESHAPI_BASE_URL=https://api.meshapi.ai

# AI Models (Routed via MeshAPI)
MESHAPI_CHAT_MODEL=openai/gpt-4o-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Application & Auth Configuration
SECRET_KEY=smartreco_super_secret_key_change_in_prod
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./smartreco.db
SQLITE_DB_PATH=smartreco.db

# Vector Database Storage Directory
CHROMA_DB_DIR=./chroma_db

# Logging
SMARTRECO_LOG_FILE=smartreco.log

